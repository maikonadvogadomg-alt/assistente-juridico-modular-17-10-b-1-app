{
  "name": "assistente-juridico-modular",
  "version": "1.6.0",
  "description": "Assistente Jurídico",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "portaDoPrograma": 10314,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.juridico.modular.nassistente1",
    "productName": "Assistente Jurídico (Assistente 1)",
    "executableName": "Assistente-Juridico-nassistente1",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "**/*",
      "!.github/**",
      "!release/**",
      "!*.zip",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Assistente Jurídico (Assistente 1)",
      "artifactName": "Assistente-Juridico-nassistente1-Instalar.exe"
    },
    "portable": {
      "artifactName": "Assistente-Juridico-nassistente1-sem-instalar.exe"
    }
  }
}
